{
  "rewrites": [
    {
      "source": "/cfb",
      "destination": "/cfb.html"
    },
    {
      "source": "/cfb/:path*",
      "destination": "/cfb.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/golf-cron",
      "schedule": "0 9 * * *"
    }
  ]
}
